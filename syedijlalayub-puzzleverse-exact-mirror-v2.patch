@@ -0,0 +1,156 @@
+name: Exact mirror PuzzleVerse V2
+
+on:
+  push:
+    branches:
+      - main
+    paths:
+      - .github/workflows/exact-mirror-puzzleverse-v2.yml
+      - .github/scripts/exact-mirror-v2.py
+      - .github/scripts/exact-mirror-audit.cjs
+  workflow_dispatch:
+
+permissions:
+  contents: write
+  pages: write
+  id-token: write
+
+concurrency:
+  group: exact-mirror-puzzleverse-v2
+  cancel-in-progress: false
+
+jobs:
+  mirror:
+    runs-on: ubuntu-latest
+    env:
+      SOURCE_ORIGIN: https://puzzleverse.syed40175.chatgpt.site
+      AUDIT_DIR: ${{ runner.temp }}/puzzleverse-audit
+      MIRROR_DIR: ${{ runner.temp }}/puzzleverse-mirror/site
+
+    steps:
+      - name: Check out main
+        uses: actions/checkout@v4
+        with:
+          ref: main
+          fetch-depth: 0
+
